GRANT EXECUTE ON FUNCTION public.get_video_analytics(UUID) TO authenticated;

-- Service role gets full access
GRANT EXECUTE ON FUNCTION public.add_credits(UUID, INT) TO service_role;
GRANT EXECUTE ON FUNCTION public.deduct_credits(UUID, INT) TO service_role;

