DROP FUNCTION IF EXISTS public.get_video_analytics(UUID);
CREATE OR REPLACE FUNCTION public.get_video_analytics(
  p_video_id UUID
)
RETURNS TABLE(
  date DATE,
  views INT,
  unique_viewers INT,
  watch_time_seconds BIGINT,
  average_view_percentage DECIMAL
)
LANGUAGE plpgsql
SECURITY INVOKER
SET search_path = public
AS $$
BEGIN
  RETURN QUERY
  SELECT
    vm.date,
    vm.views,
    vm.unique_viewers,
    vm.watch_time_seconds,
    vm.average_view_percentage
  FROM public.video_metrics vm
  WHERE vm.video_id = p_video_id
    AND vm.user_id = (select auth.uid())
  ORDER BY vm.date DESC;
END;
$$;

