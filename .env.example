# ============================================================
# VOXARA SAAS — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in all values.
# Never commit .env.local to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App URL ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI / Script Generation with GenKit ──────────────────────
GOOGLE_GENAI_API_KEY=your-google-genai-api-key
GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-api-key

# ── Payment Provider (paddle or flutterwave) ──────────────────
PAYMENT_PROVIDER=paddle

# ── Paddle Billing (Global Payments in USD) ──────────────────────
PADDLE_VENDOR_ID=your-paddle-vendor-id
PADDLE_SANDBOX_MODE=true
PADDLE_API_KEY=your-paddle-api-key
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your-paddle-client-token

# Paddle Product/Price IDs
PADDLE_PRO_PLAN_ID=pri_100001
PADDLE_AGENCY_PLAN_ID=pri_100002
PADDLE_CREDIT_PRODUCT_ID=pri_100003

# ── Flutterwave (Local/NGN Payments) ──────────────────────────
FLUTTERWAVE_PUBLIC_KEY=pk_test_...
FLUTTERWAVE_SECRET_KEY=sk_test_...
FLUTTERWAVE_WEBHOOK_SECRET=your-flutterwave-webhook-secret
FLUTTERWAVE_ENCRYPTION_KEY=your-flutterwave-encryption-key

# Flutterwave Plan IDs (for subscriptions)
FLUTTERWAVE_PRO_PLAN_ID=123456
FLUTTERWAVE_AGENCY_PLAN_ID=123457

# ── Stripe (Legacy - Optional, being phased out) ──────────────
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Video Streaming (Mux) ─────────────────────────────────────
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_WEBHOOK_SECRET=your-mux-webhook-secret

# ── Background Jobs (Inngest) ─────────────────────────────────
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# ── Rate Limiting (Upstash Redis) ─────────────────────────────
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_WINDOW=60

# ── Social Platform OAuth ─────────────────────────────────────
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret

TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret

LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# ── Stock Footage ─────────────────────────────────────────────
PEXELS_API_KEY=your-pexels-api-key

# ── Avatar Providers ──────────────────────────────────────────
HEYGEN_API_KEY=your-heygen-api-key
HEYGEN_WEBHOOK_SECRET=your-heygen-webhook-secret
DID_API_KEY=your-d-id-api-key
SYNTHESIA_API_KEY=your-synthesia-api-key

# ── Voice Cloning ─────────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ── Error Tracking & Monitoring (Sentry) ──────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=xxx
SENTRY_ENVIRONMENT=production

# ── Two-Factor Authentication (2FA) ───────────────────────────
NEXT_PUBLIC_2FA_ENABLED=true
TWO_FA_ISSUER=voxara
TWO_FA_WINDOW_SIZE=30
TWO_FA_BACKUP_CODES_COUNT=10

# ── Admin Panel Configuration ──────────────────────────────────
NEXT_PUBLIC_ADMIN_ENABLED=true
ADMIN_EMAILS=admin@voxara.app,support@voxara.app
ADMIN_WEBHOOK_SECRET=your-admin-webhook-secret

# ── Feature Flags ──────────────────────────────────────────────
NEXT_PUBLIC_FEATURE_MARKETPLACE=true
NEXT_PUBLIC_FEATURE_TEAM_COLLAB=true
NEXT_PUBLIC_FEATURE_API_ACCESS=true
NEXT_PUBLIC_FEATURE_WEBHOOKS=true
NEXT_PUBLIC_FEATURE_WHITE_LABEL=true
NEXT_PUBLIC_FEATURE_ANALYTICS=true

# ── Monitoring & Performance ───────────────────────────────────
NEXT_PUBLIC_ANALYTICS_ENABLED=true
MONITORING_ENABLED=true
PERFORMANCE_MONITORING_ENABLED=true
ERROR_TRACKING_ENABLED=true
LOG_LEVEL=info
LOG_FORMAT=json
