# ================================================================
# Voxara — Environment Variables Reference
# Copy to .env.local for local development.
# Set ALL of these in your Vercel project settings for production.
# ================================================================

# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://voxara.app
NODE_ENV=production

# ── Supabase (REQUIRED) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_PROJECT_REF=xxxxxxxxxxxx
SUPABASE_DB_PASSWORD=your-db-password

# ── AI — Script Generation (at least one required) ────────────────
# Primary: Gemini Flash (cheaper, faster)
GEMINI_API_KEY=AIza...
GOOGLE_GENAI_API_KEY=AIza...
GOOGLE_GENERATIVE_AI_API_KEY=AIza...
# Fallback: Claude
ANTHROPIC_API_KEY=sk-ant-...

# ── Voice Synthesis ───────────────────────────────────────────────
# Required for Pro/Agency plans (free tier uses Edge-TTS, no key needed)
ELEVENLABS_API_KEY=sk_...

# ── Video Streaming (Mux) ─────────────────────────────────────────
# Required for Pro/Agency plans
MUX_TOKEN_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MUX_TOKEN_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MUX_WEBHOOK_SECRET=your-mux-webhook-signing-secret

# ── AI Avatars ────────────────────────────────────────────────────
HEYGEN_API_KEY=your-heygen-api-key
HEYGEN_WEBHOOK_SECRET=your-heygen-webhook-secret
DID_API_KEY=your-did-api-key
SYNTHESIA_API_KEY=your-synthesia-api-key

# ── Stock Footage ─────────────────────────────────────────────────
PEXELS_API_KEY=your-pexels-api-key

# ── Background Jobs (Inngest) ─────────────────────────────────────
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@voxara.app
ADMIN_ALERT_EMAIL=ops@voxara.app

# ── Payments ──────────────────────────────────────────────────────
# Set PAYMENT_PROVIDER to either 'paddle' or 'flutterwave'
PAYMENT_PROVIDER=paddle

# Paddle (Global)
PADDLE_API_KEY=your-paddle-api-key
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret
PADDLE_PRO_MONTHLY_PRICE_ID=pri_...
PADDLE_PRO_YEARLY_PRICE_ID=pri_...
PADDLE_AGENCY_MONTHLY_PRICE_ID=pri_...
PADDLE_AGENCY_YEARLY_PRICE_ID=pri_...
PADDLE_CREDITS_10_PRICE_ID=pri_...
PADDLE_CREDITS_25_PRICE_ID=pri_...
PADDLE_CREDITS_50_PRICE_ID=pri_...

# Flutterwave (Africa / NGN)
FLUTTERWAVE_SECRET_KEY=FLWSECK-...
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-...
FLUTTERWAVE_WEBHOOK_SECRET=your-flutterwave-webhook-secret

# ── Rate Limiting (Upstash Redis) ─────────────────────────────────
# Optional — app works without it, rate limiting is disabled
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_WINDOW=60

# ── Error Monitoring (Sentry) ─────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=voxara
SENTRY_ENVIRONMENT=production

# ── Social Publishing OAuth ───────────────────────────────────────
YOUTUBE_CLIENT_ID=xxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-...
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
INSTAGRAM_CLIENT_ID=your-instagram-app-id
INSTAGRAM_CLIENT_SECRET=your-instagram-app-secret
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# ── Remotion Rendering Backend ────────────────────────────────────
# 'auto' = Lambda if REMOTION_LAMBDA_FUNCTION_NAME set, else passthrough
# 'local' = Remotion Node (Docker/self-hosted only)
# 'lambda' = Force AWS Lambda
RENDER_BACKEND=auto

# Remotion Lambda (for Vercel deployments with real video composition)
# Deploy with: npx remotion lambda functions deploy
REMOTION_LAMBDA_FUNCTION_NAME=remotion-render-4-0-272-mem2048mb-disk2048mb-120sec
REMOTION_SERVE_URL=https://remotionlambda-xxxx.s3.amazonaws.com/sites/voxara/index.html
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-aws-secret

# ── Admin ─────────────────────────────────────────────────────────
# Comma-separated Supabase user UUIDs with admin access
ADMIN_USER_IDS=uuid1,uuid2

# 2FA TOTP secret encryption (AES-256-GCM)
# Generate: openssl rand -base64 32
# Falls back to SUPABASE_SERVICE_ROLE_KEY if not set
TOTP_ENCRYPTION_KEY=your-32-byte-base64-key
